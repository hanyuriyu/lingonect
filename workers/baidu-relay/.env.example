# Copy to .env and fill in. .env is gitignored — keep it off the repo.
#
#   cp .env.example .env

# Hostname the worker will call. Needs a DNS-only (grey cloud) A record
# pointing at this box, so Caddy can complete the certificate challenge.
RELAY_DOMAIN=relay.example.com

# Shared secret. Generate one and use the SAME value for the worker's
# BAIDU_RELAY_TOKEN:   openssl rand -hex 32
RELAY_TOKEN=

# The numeric App ID from 开发者信息. The relay refuses any other App ID, which
# is what keeps this IP from ever earning a 58003 ban of its own.
# NOT the secret key — that stays in the Cloudflare worker and never comes here.
BAIDU_APP_ID=
