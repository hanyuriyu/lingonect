<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the main app, so an image shared to Lingonect can be
	     handed over as a file (see ShareViewController.swift). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.lingonect.app</string>
	</array>
</dict>
</plist>
